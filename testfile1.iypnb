# ==========================================
# 1. IMPORTS
# ==========================================
import matplotlib.pyplot as plt
import torch
import torch.nn as nn
import torch.optim as optim
from torchvision import transforms
from sklearn.impute import SimpleImputer


# ==========================================
# 2. FASHIONMNIST: FIRST THREE VALIDATION IMAGES
# Resize to 16x16, convert to tensors, and display
# ==========================================

resize_transform = transforms.Compose([
    transforms.Resize((16, 16)),
    transforms.ToTensor()
])

fig, axes = plt.subplots(1, 3, figsize=(9, 3))

for i in range(3):
    image, label = fashion_val_dataset[i]

    # Correctly handle tensor and PIL images
    if isinstance(image, torch.Tensor):
        image = transforms.Resize((16, 16))(image)
    else:
        image = resize_transform(image)

    # Convert to tensor if needed
    if not isinstance(image, torch.Tensor):
        image = transforms.ToTensor()(image)

    # Display the image with its label
    axes[i].imshow(image.squeeze().cpu().numpy(), cmap="gray")
    axes[i].set_title(f"y = {int(label)}")
    axes[i].axis("off")

    print(
        f"Sample {i + 1}: "
        f"Label = {int(label)}, "
        f"Image shape = {tuple(image.shape)}"
    )

plt.tight_layout()
plt.show()


